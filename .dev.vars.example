# 复制为 .dev.vars 后本地 wrangler dev 生效（不要提交真实密钥）
#
# 注意：wrangler.jsonc 里声明了 secrets.required = ["AMD_ACCOUNTS", "ACCESS_TOKEN"]，
# 一旦声明该字段，本地 dev 只加载本文件中列在 required 里的键，其余会被静默忽略
# （ADMIN_TOKEN 就没列入，本地设了也不会生效）。
# 本地调试管理接口时，用 ACCESS_TOKEN 的值访问（它会作为 ADMIN_TOKEN 的回退）。

# 账号池：JSON 数组，label 是自己起的名字，apiKey 是 rc- 开头的 AMD key
AMD_ACCOUNTS='[{"label":"acct-a","apiKey":"rc-xxxxxxxx"},{"label":"acct-b","apiKey":"rc-yyyyyyyy"}]'

# 客户端访问本代理需要的 token（不设则接口对外开放）
ACCESS_TOKEN=change-me-access

# 管理接口 token（/admin/*），不设则管理接口关闭
# 注意：该键未列入 wrangler.jsonc 的 secrets.required，因此本地 dev 不会加载它；
# 本地请用 ACCESS_TOKEN 访问 /admin/*（代码会回退）。部署后若要独立设置管理员 token，
# 在面板加成 Secret 即可正常生效。
ADMIN_TOKEN=change-me-admin

# 可选：覆盖上游地址
# AMD_API_BASE=https://developer.amd.com.cn/radeon/api
# AMD_PLATFORM_BASE=https://radeon-global.anruicloud.com

# 可选：调度参数
# MAX_KEY_ATTEMPTS=3
# RPM_LIMIT=20
# QUOTA_TTL_SECONDS=60
# PROBE_MODEL=DeepSeek-V4-Flash

# 可选：仅当你希望 /admin/redeploy 能自动重新部署时才需要
# CF_API_TOKEN=
# CF_ACCOUNT_ID=
# CF_SCRIPT_NAME=amd-api-balancer

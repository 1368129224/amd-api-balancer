# AMD AI Key Balancer — 环境变量示例
# 复制本文件为 .env，填入你的实际值，然后 docker compose up
#
# 注意：.env 文件里的内容不要提交到 Git（.gitignore 已排除 .env）

# ── AMD API 账号池（必填）────────────────────────────────────────────────────
# JSON 数组，每个元素是一个账号对象
# 多账号示例：
# AMD_ACCOUNTS=[{"label":"acct-a","apiKey":"rc-aaaa1111"},{"label":"acct-b","apiKey":"rc-bbbb2222"}]
AMD_ACCOUNTS=[{"label":"acct-a","apiKey":"rc-your-key-here"}]

# ── 访问认证（强烈建议设置）────────────────────────────────────────────────
# 客户端调用推理接口时需要携带此 token（放在 Authorization: Bearer 头里）
# 不设置时接口对所有人开放
ACCESS_TOKEN=your-access-token-here

# 管理接口 token（/admin/* 和看板管理操作），不填则回退用 ACCESS_TOKEN
# ADMIN_TOKEN=your-admin-token-here

# ── Cloudflare 部署（docker compose run deploy 时使用）──────────────────────
# 在 https://dash.cloudflare.com/profile/api-tokens 创建 API Token
# 权限：Workers Scripts:Edit + Workers Routes:Edit + Account Settings:Read
# CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
# CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id

# ── 可选：调优参数 ───────────────────────────────────────────────────────────
# PORT=8787                   # 本地监听端口（映射到 8787）
# QUOTA_TTL_SECONDS=60        # 额度缓存时长（秒）
# MAX_KEY_ATTEMPTS=3          # 单次请求最多尝试几个 key
# RPM_LIMIT=20                # 单 key 每分钟请求上限
# RATE_COOLDOWN_SECONDS=30    # 限流冷却时长（秒）

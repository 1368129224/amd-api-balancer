# 固定使用官方 npm 源。
#
# 原因：package-lock.json 里的 resolved URL 与构建环境强相关。本机原本用的是
# registry.npmmirror.com（国内镜像），Cloudflare 的构建机在海外访问它很可能超时，
# 导致 npm ci 失败。已验证两个源的 tarball SHA-512 完全一致，所以改指官方源是安全的。
#
# 放在项目内而不是全局，是为了让别人 clone 之后 npm install 也走官方源，
# 不会又把 lockfile 改回镜像地址。
registry=https://registry.npmjs.org/

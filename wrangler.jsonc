{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amd-api-balancer",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BALANCER",
        "class_name": "Balancer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Balancer"]
    }
  ],
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  // 部署前强制校验这些 Secret 已配置。
  //
  // 为什么需要：Secret 缺配时部署会「成功」，但 Worker 起来是没有密钥的，
  // 表现为 /health 里 accounts: 0、auth_required: false，很难看出是漏配。
  // 声明为 required 后，wrangler deploy 会直接校验这些密钥，
  // 并且本地 wrangler dev 也会正确注入这些环境变量。
  "secrets": {
    "required": ["AMD_ACCOUNTS", "ACCESS_TOKEN", "ADMIN_TOKEN"]
  },
  "vars": {
    "AMD_API_BASE": "https://developer.amd.com.cn/radeon/api",
    "AMD_PLATFORM_BASE": "https://radeon-global.anruicloud.com",
    "QUOTA_TTL_SECONDS": "60",
    "MAX_KEY_ATTEMPTS": "3",
    "RPM_LIMIT": "20"
  }
}
